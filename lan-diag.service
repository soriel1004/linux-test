[Unit]
Description=Passive LAN diagnostics for Ubuntu inspection equipment
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -u /opt/lan-diag/current/service_runner.py --config /etc/lan-diag/config.json --output /var/log/lan-diag
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=180
LogsDirectory=lan-diag
LogsDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log/lan-diag
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
